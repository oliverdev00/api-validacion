# Configuración de la API de validación real
# Reemplaza con la URL de tu proveedor externo de validación de documento
VALIDATOR_API_URL=https://api.tu-proveedor.com/validar
VALIDATOR_API_METHOD=GET
# Si tu proveedor usa token Bearer, deja este valor
VALIDATOR_API_TOKEN=
# Tiempo en milisegundos para esperar la respuesta de la API externa
VALIDATOR_API_TIMEOUT=8000
